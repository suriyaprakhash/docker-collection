# Run the following to generate a random password and secret key for your authentik installation. You can run these commands in your terminal to append the generated values to your .env file.
# echo "PG_PASS=$(openssl rand -base64 36 | tr -d '\n')" >> .env
# echo "AUTHENTIK_SECRET_KEY=$(openssl rand -base64 60 | tr -d '\n')" >> .env
PG_PASS=
AUTHENTIK_SECRET_KEY=
COMPOSE_PORT_HTTP=8083
COMPOSE_PORT_HTTPS=8084